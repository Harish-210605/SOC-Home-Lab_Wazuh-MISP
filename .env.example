# Copy to .env, or just run scripts/wazuh-bootstrap.sh, which generates strong
# values for all three. The real .env is gitignored and never committed.
#
# The Wazuh API rejects weak passwords: minimum 8 characters with at least one
# uppercase, one lowercase, one digit and one symbol.

# Indexer 'admin' superuser. Also how the manager and dashboard authenticate
# to the indexer. This is the login for the web UI.
INDEXER_PASSWORD=replace-me

# Internal 'kibanaserver' service account, used only by the dashboard.
DASHBOARD_PASSWORD=replace-me

# Wazuh manager API account 'wazuh-wui'.
API_PASSWORD=replace-me

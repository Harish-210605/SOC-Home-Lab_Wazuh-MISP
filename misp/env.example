# Copy to misp/.env, or just run scripts/misp-bootstrap.sh, which generates
# strong values. The real misp/.env is gitignored and never committed.
#
# Upstream's full variable list is misp/misp-docker/template.env — it covers
# OIDC, LDAP, S3, SMTP and much else. Only the keys this lab actually sets are
# listed here; everything else keeps its upstream default.

# --- image pinning ---
# Upstream defaults these to :latest, which makes the deployment
# unreproducible. Pin them.
CORE_RUNNING_TAG=v2.5.44
MODULES_RUNNING_TAG=v3.0.9

# --- addressing ---
# Keep this portless. The misp-core healthcheck curls BASE_URL from inside the
# container, where only ports 80/443 exist, so a remapped port here makes the
# healthcheck fail permanently.
BASE_URL=https://localhost

# --- admin account (upstream defaults to admin@admin.test / admin) ---
ADMIN_EMAIL=admin@soclab.local
ADMIN_ORG=SOCLAB
ADMIN_PASSWORD=replace-me

# Set explicitly. Left blank, MISP mints a random key at first boot that is
# never written down, and recovering it means 'cake user change_authkey',
# which invalidates the old one. Phase 5 needs a stable key. 40 alphanumerics.
ADMIN_KEY=replace-me

# --- internal job supervisor (upstream default: 'supervisor') ---
SUPERVISOR_PASSWORD=replace-me

# --- log hygiene ---
# Left unset, misp-core echoes the Redis and supervisor passwords in clear text
# into its container logs on every boot.
DISABLE_PRINTING_PLAINTEXT_CREDENTIALS=true

# --- database (upstream defaults: 'example' and 'password') ---
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me

# --- cache (upstream default: 'redispassword') ---
REDIS_PASSWORD=replace-me

# --- resource tuning ---
# Upstream default is 2048M, sized for a dedicated MISP host.
INNODB_BUFFER_POOL_SIZE=512M
